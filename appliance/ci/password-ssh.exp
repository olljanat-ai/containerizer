#!/usr/bin/expect -f
# CI: sign in to the appliance as root with a password (no key), through the boot test's port forward.
#   password-ssh.exp change <password> <new password>  sign in; must be asked for a new password, sets it
#   password-ssh.exp run <password> <command>           sign in and run the command; fails if asked for a new password
set mode [lindex $argv 0]
set pw [lindex $argv 1]
set arg [lindex $argv 2]
set cmd [expr {$mode eq "change" ? "true" : $arg}]
set timeout 90
spawn ssh -tt -p 2222 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR \
  -o ConnectTimeout=10 -o PubkeyAuthentication=no -o PreferredAuthentications=keyboard-interactive,password \
  -o NumberOfPasswordPrompts=1 root@127.0.0.1 $cmd
set asked 0
expect {
  -nocase -re {new password: ?$} {
    if {$mode ne "change"} { puts "\nasked for a new password"; exit 3 }
    set asked 1; send -- "$arg\r"; exp_continue
  }
  -nocase -re {password: ?$} { send -- "$pw\r"; exp_continue }
  timeout { puts "\ntimed out"; exit 4 }
  eof
}
set status [lindex [wait] 3]
if {$mode eq "change"} { exit [expr {$asked ? 0 : 5}] }
exit $status
