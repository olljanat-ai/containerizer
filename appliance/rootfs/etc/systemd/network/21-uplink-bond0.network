# DHCP (IPv4 and IPv6) on the bond of every wired interface (20-uplink.network). The DHCP client ID is the
# bond's MAC (its first NIC's, 21-uplink-bond0.netdev): the same in the recovery system that installs the
# appliance and in the installed system, which have different machine-ids, so the appliance keeps one address
# through installing, reinstalling and upgrading, and a DHCP reservation by MAC address works. (A machine-id
# based ID, 0.9.3-0.11.0, gave the installed system a second address after the recovery system's.)
[Match]
Name=bond0

[Network]
DHCP=yes
IPv6AcceptRA=yes
LLMNR=no
MulticastDNS=no

[DHCPv4]
ClientIdentifier=mac
UseDomains=no
