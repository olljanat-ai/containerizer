# bond0, the bond of every wired interface (20-uplink.network), is the port of the bridge br0, which has the
# address (22-uplink-br0.network): no address, DHCP or link-local address of its own.
[Match]
Name=bond0

[Network]
Bridge=br0
LinkLocalAddressing=no
IPv6AcceptRA=no
LLMNR=no
MulticastDNS=no

[Link]
RequiredForOnline=no
