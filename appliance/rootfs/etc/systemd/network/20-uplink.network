# Every wired interface joins bond0 (active-backup, as olljanat/nomad-qemu-node does with netplan): on a server
# with several NICs the appliance stays reachable when a cable, a NIC or a switch port fails; on a VM with one
# NIC it works as that NIC. The address is
# on bond0 (21-uplink-bond0.network). Static addressing: drop a .network file with a lower number for
# Name=bond0 into /etc/containerizer/network/ (docs/appliance-admin.md#network).
[Match]
Name=e*

[Network]
Bond=bond0
# the switch sees which port the appliance is on (and it sees the switch: networkctl lldp)
LLDP=yes
EmitLLDP=nearest-bridge
LinkLocalAddressing=no

[Link]
# a port without a cable does not hold up the boot: bond0 is what has to come up
RequiredForOnline=no
