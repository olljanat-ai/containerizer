# HTTPS for the web UI, Grafana and OpenBao. The site names come from /run/containerizer/caddy.env (written by
# cz-firstboot from CZ_HOSTNAME and the addresses of the appliance). The certificate is your own
# (/etc/containerizer/tls; CZ_CADDY_TLS is then "<cert> <key>"), else Let's Encrypt when CZ_ACME_EMAIL is set
# (TLS-ALPN challenge on 443: allow acme-v02.api.letsencrypt.org on the Firewall page), else Caddy's own CA.
{
	admin off
	http_port 8081
	auto_https disable_redirects
	# a connection without a server name (https://<address> when the address is not a site yet: it changed since
	# boot) gets the appliance name's certificate instead of a TLS alert
	default_sni {$CZ_SNI}
	{$CZ_CADDY_ACME}
	servers {
		protocols h1 h2
	}
}

{$CZ_SITES} {
	tls {$CZ_CADDY_TLS}
	encode zstd gzip
	header -Server
	handle /grafana* {
		reverse_proxy 127.0.0.1:3000
	}
	# the sign-in to OpenBao the admin pages' Secrets link started (admin.openbao_start, docs/openbao.md): its
	# callback goes to the web UI, which completes it; every other sign-in's callback goes to OpenBao's UI
	@baosso {
		path /ui/vault/auth/oidc/oidc/callback
		header Cookie *cz_bao_sso=*
	}
	handle @baosso {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Forwarded-Proto https
		}
	}
	# OpenBao (docs/openbao.md): its UI and the API the UI and the bao CLI use
	handle /ui* {
		reverse_proxy 127.0.0.1:8200
	}
	handle /v1/* {
		reverse_proxy 127.0.0.1:8200
	}
	handle {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Forwarded-Proto https
		}
	}
	log {
		output stderr
		format console
	}
}

# kubemg (optional, CZ_KUBEMG=true): its own name, written by cz-firstboot; absent when it is off.
import /run/containerizer/kubemg*.caddy

# The apps in the k3s sandbox under the administrators' wildcard domain (Admin -> Sandbox HTTPS): written by
# the system agent; absent until a domain and certificate are set up.
import /var/lib/containerizer/system/sandbox-https*.caddy
