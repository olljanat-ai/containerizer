# /etc/containerizer/grafana.env: extra Grafana settings (GF_*), e.g. sign-in with your identity provider:
# GF_AUTH_GENERIC_OAUTH_ENABLED=true
# GF_AUTH_GENERIC_OAUTH_NAME=SSO
# GF_AUTH_GENERIC_OAUTH_CLIENT_ID=
# GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=
# GF_AUTH_GENERIC_OAUTH_AUTH_URL=
# GF_AUTH_GENERIC_OAUTH_TOKEN_URL=
# GF_AUTH_GENERIC_OAUTH_API_URL=
# GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email
# With a provider enabled, the user name and password form is hidden and sign-in goes straight to the provider;
# GF_AUTH_DISABLE_LOGIN_FORM=false brings the form back (docs/sign-in.md).
