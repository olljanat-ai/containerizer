# /etc/containerizer/appliance.env: settings of the appliance itself (mode 600, kept across upgrades).
# Restart the affected services after a change, or reboot.

# Name the web UI is reached at; the HTTPS certificate is issued for it (and for the appliance's addresses).
# Empty: the host name. Also sets CONTAINERIZER_PUBLIC_URL (the sign-in redirect) unless web.env sets it.
CZ_HOSTNAME=
# Empty: certificate from Caddy's own CA (browsers warn until you trust it:
# /var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt). Set an e-mail address to get a
# Let's Encrypt certificate instead (CZ_HOSTNAME must be a public DNS name pointing here; allow
# acme-v02.api.letsencrypt.org on the Firewall page).
CZ_ACME_EMAIL=
# DNS servers for allowed names. Empty: the ones from DHCP.
CZ_DNS_SERVERS=
# SQL Server edition: Express (free, 10 GB per database), Standard or Enterprise with a product key
# (MSSQL_PID accepts the key), Developer only for non-production use.
CZ_MSSQL_EDITION=Express
CZ_MSSQL_MEMORY=4g
# External results database (docs/appliance-admin.md#external-database). Empty CZ_SQL_SERVER: SQL Server runs on
# the appliance (back it up). Set it, and SQL Server does not run here: the database lives, and is backed up,
# on your server. CZ_SQL_SERVER: host, or host,port (default 1433); the firewall allows it by itself.
# CZ_SQL_USER: a login with db_owner on CZ_SQL_DATABASE (create the database first); its password goes into
# /etc/containerizer/secrets/sql-owner. It creates or upgrades the schema at every start.
# CZ_SQL_LOGINS: create (CZ_SQL_USER also creates the logins cz_scanner, cz_web and cz_admin; needs
# ALTER ANY LOGIN) or existing (you created them; put their passwords in secrets/cz-scanner, cz-web, cz-admin).
# CZ_SQL_OPTIONS: more connection string options in quotes, e.g. "Encrypt=yes;Schema=containerizer".
# The certificate is checked against the system CAs, or the PEM file CZ_SQL_CA (e.g. /etc/containerizer/sql-ca.pem).
# Reboot after a change.
CZ_SQL_SERVER=
CZ_SQL_DATABASE=Containerizer
CZ_SQL_USER=
CZ_SQL_LOGINS=create
CZ_SQL_OPTIONS=
CZ_SQL_CA=
# LLM-heavy mode: platform migrations of already containerized apps and the sandbox tester ask the LLM as
# often as they need (more calls, tokens and cost; docs/platform-migration.md). false: off. true: scans that
# have "LLM-heavy mode" ticked under Admin -> Organization scans use it. Reboot after a change.
CZ_LLM_HEAVY=false
