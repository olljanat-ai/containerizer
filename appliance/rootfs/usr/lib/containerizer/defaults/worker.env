# /etc/containerizer/worker.env: the scan worker (docs/scheduled-scans.md). Mode 600.
# Read-only organization tokens, named in each scan's "Token variable" (CZ_TOKEN_<NAME>)
GITHUB_TOKEN=
# CZ_TOKEN_CONTOSO=
# push access to the output repository only ("Output token variable", default OUTPUT_GIT_TOKEN)
OUTPUT_GIT_TOKEN=
# Push-only credentials for an external registry. Scans that use the appliance's own registry
# (Registry: localhost:5000/<path>) need none.
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
# hosts besides github.com, gitlab.com, dev.azure.com and *.visualstudio.com that may receive tokens
CONTAINERIZER_WORKER_HOSTS=
# Every host a scan reaches (Git servers, package feeds, registries) must also be on the Firewall page.
