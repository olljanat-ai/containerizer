# /etc/containerizer/sandbox.env: connect the sandbox cluster (k3s + Flux on this appliance) to the
# output repository of your organization scans. Mode 600. Applied every 2 minutes by cz-sandbox.
# Repository URL (HTTPS) and branch, and a read-only token for it.
CZ_SANDBOX_GIT_URL=
CZ_SANDBOX_GIT_BRANCH=main
CZ_SANDBOX_GIT_USERNAME=git
CZ_SANDBOX_GIT_TOKEN=
