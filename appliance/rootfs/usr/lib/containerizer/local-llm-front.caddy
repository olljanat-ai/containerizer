# The built-in LLM's front (containerizer-local-llm.service): 127.0.0.1:8082 for the scan worker and the LLM
# queue, sending each request to the least busy llama.cpp server (one per NUMA node, containerizer/local_llm.py).
# CZ_LLM_PORT and CZ_LLM_UPSTREAMS ("127.0.0.1:8090 127.0.0.1:8091") come from /run/containerizer/local-llm.env.
{
	admin off
	auto_https off
	servers {
		protocols h1
	}
}

http://:{$CZ_LLM_PORT} {
	bind 127.0.0.1
	reverse_proxy {$CZ_LLM_UPSTREAMS} {
		lb_policy least_conn
		# while every server is busy loading its model, a request waits a little for one
		lb_try_duration 30s
		lb_try_interval 2s
		health_uri /health
		health_interval 10s
		health_timeout 5s
		# answers are streamed; a prompt of 15K tokens takes minutes before the first byte (no response timeout)
		flush_interval -1
	}
}
