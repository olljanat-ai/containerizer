# Container images of the appliance's own services, pinned by digest (the tag is for people). An OS
# upgrade brings new pins; Docker pulls them on first start.
CZ_IMAGE_MSSQL=mcr.microsoft.com/mssql/server:2025-CU10-ubuntu-24.04@sha256:245f6b1c8903edae52cb20fa31419cefcde1a49938bb8c3447099011fc871ca3
CZ_IMAGE_PROMETHEUS=docker.io/prom/prometheus:v3.15.1@sha256:fa3302279710be2f21a8301ec17a8b4f2301fd829bd113839b3b6b02b6f191a2
CZ_IMAGE_GRAFANA=docker.io/grafana/grafana:13.3.0@sha256:488984b716c0862639f91a698adbe2862677a5a07bad42da5f03f3030883b205
CZ_IMAGE_REGISTRY=docker.io/library/registry:3.1.2@sha256:d4032d4cc323c1731c707931ecada07a53076eac38e3b61ae57533f170f2c6c3
# Lab services in the k3s sandbox (Admin -> Lab services, docs/lab-services.md); SQL Server uses CZ_IMAGE_MSSQL.
# k3s pulls them when an administrator turns a service on and the first app asks for it.
CZ_IMAGE_LAB_POSTGRES=docker.io/library/postgres:18.6-alpine@sha256:10a5c69a83035ab5239f5620d708520e8b28f5aa1f2b20143e6024532edadfb5
CZ_IMAGE_LAB_REDIS=docker.io/library/redis:8.8.4-alpine@sha256:ab669f1420eaa05360a417b24f3bd210c9272e2c79a4bb35d3e50b4bfd50dbee
CZ_IMAGE_LAB_S3=docker.io/versity/versitygw:v1.10.0@sha256:89cad13cc981986ee284cbafea4613f9533ce6fd5f37a2c96c4c4fb8adb3a316
CZ_IMAGE_LAB_AZURITE=mcr.microsoft.com/azure-storage/azurite:3.37.0@sha256:830430c1da1a2d537e08f3e6764dd1f5ae00cf0346bcaf625b968ec3f0971fd5
