#!/bin/sh
# Connection strings from /run/containerizer/sql.env (cz-firstboot, from appliance.env); web.env may set its own.
export CONTAINERIZER_SQL="${CONTAINERIZER_SQL:-$CZ_SQL_WEB_CS}"
export CONTAINERIZER_ADMIN_SQL="${CONTAINERIZER_ADMIN_SQL:-$CZ_SQL_ADMIN_CS}"
# Passwords from systemd credentials (root-only files on the persistent partition), never in the unit.
CONTAINERIZER_SQL_PASSWORD="$(cat "$CREDENTIALS_DIRECTORY/sql-web")"
CONTAINERIZER_ADMIN_SQL_PASSWORD="$(cat "$CREDENTIALS_DIRECTORY/sql-admin")"
export CONTAINERIZER_SQL_PASSWORD CONTAINERIZER_ADMIN_SQL_PASSWORD
# seals source control tokens for the worker; cannot open them
export CONTAINERIZER_CREDENTIAL_PUBLIC_KEY_FILE="$CREDENTIALS_DIRECTORY/credential-public-key"
exec /usr/lib/containerizer/venv/bin/python -m containerizer web --host 127.0.0.1 --port 8080
