#!/bin/bash
# root's password: "containerizer" until changed, and expired, so the first sign-in on the console or over
# SSH asks for a new one (PAM). /etc is a tmpfs overlay, so root's /etc/shadow entry is kept on the
# persistent partition, in /etc/containerizer/secrets/root-shadow: put back at every boot (restore) and
# saved whenever /etc/shadow changes (save). The recovery system always starts with the default.
#   cz-root-password restore|save
set -euo pipefail
umask 077
F=/etc/containerizer/secrets/root-shadow
# TEMPORARY (0.3.3): the default password is not expired, so no sign-in is forced to change it; set yes to
# ask for a new one at the first sign-in again
EXPIRE_DEFAULT=no
persistent() { [ ! -f /run/elemental/recovery_mode ] && [ -d "${F%/*}" ]; }
case "${1:-}" in
  restore)
    if persistent && IFS=: read -r _ hash lastchg _ < <(grep '^root:' "$F" 2>/dev/null) && [ -n "$hash" ]; then
      usermod -p "$hash" root
      # a line saved while the default was still expired has 0; with EXPIRE_DEFAULT=no it does not expire it again
      [ "$EXPIRE_DEFAULT" = yes ] || [ "${lastchg:-0}" != 0 ] || lastchg=$(( $(date +%s) / 86400 ))
      chage -d "${lastchg:-0}" root
    else
      echo 'root:containerizer' | chpasswd
      [ "$EXPIRE_DEFAULT" = yes ] && chage -d 0 root
      :
    fi
    ;;
  save)
    persistent || exit 0
    grep '^root:' /etc/shadow > "$F.new"
    mv -f "$F.new" "$F"
    ;;
  *) echo "usage: $0 restore|save" >&2; exit 2 ;;
esac
