#!/bin/bash
# kubemg on the appliance (optional, CZ_KUBEMG=true; docs/appliance-admin.md#kubemg).
#   cz-kubemg ca       before kubemg starts: the CA of the certificate Caddy serves for kubemg's name, for the
#                      agent's manifest (KUBEMG_AGENT_CA_BUNDLE): your own CA (tls/ca.pem, else the chain in
#                      tls/cert.pem), Caddy's own CA, or none for Let's Encrypt
#   cz-kubemg password the generated password of kubemg's `admin` (until it is changed in kubemg's setup wizard)
#   cz-kubemg sandbox  register the k3s sandbox cluster in kubemg and install its agent (containerizer.kubemg)
set -euo pipefail
K=/run/containerizer/kubemg
PW=/etc/containerizer/secrets/kubemg-admin
if [ "${1:-}" = password ]; then
  [ -r "$PW" ] || { echo "cz-kubemg: $PW is not there or not readable (root only; is CZ_KUBEMG=true?)" >&2; exit 1; }
  cat "$PW"; echo
  exit 0
fi
. "$K/kubemg.env"
case "${1:-}" in
ca)
  install -d -m 0755 "$K/ca"
  rm -f "$K/ca/ca.pem"
  : > "$K/ca.env"
  T=/etc/containerizer/tls
  CADDY_CA=/var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt
  src=
  if [ -s /run/containerizer/tls/key.pem ]; then
    if [ -s "$T/ca.pem" ]; then src="$T/ca.pem"; else src="$T/cert.pem"; fi
  elif [ -z "${CZ_ACME_EMAIL:-}" ]; then
    # Caddy creates its CA when it first serves a site: wait for it
    for _ in $(seq 60); do [ -s "$CADDY_CA" ] && break; sleep 2; done
    [ -s "$CADDY_CA" ] || { echo "cz-kubemg: Caddy's CA ($CADDY_CA) is not there" >&2; exit 1; }
    src="$CADDY_CA"
  fi
  if [ -n "$src" ]; then
    install -m 0644 "$src" "$K/ca/ca.pem"
    echo "KUBEMG_AGENT_CA_BUNDLE=/ca/ca.pem" > "$K/ca.env"
  fi
  # kubemg logs no password (the appliance sets it): say where it is
  echo "kubemg: https://$CZ_KUBEMG_HOST/ - sign in as admin with the password in $PW (/usr/lib/containerizer/bin/cz-kubemg password)"
  ;;
sandbox)
  exec /usr/lib/containerizer/venv/bin/python -m containerizer.kubemg sandbox --host "$CZ_KUBEMG_HOST" \
    --password-file "$PW"
  ;;
*) echo "usage: cz-kubemg ca|password|sandbox" >&2; exit 2 ;;
esac
