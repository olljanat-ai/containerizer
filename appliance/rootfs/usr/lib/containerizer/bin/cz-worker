#!/bin/sh
# connection string from /run/containerizer/sql.env (cz-firstboot, from appliance.env); worker.env may set its own
export CONTAINERIZER_SQL="${CONTAINERIZER_SQL:-$CZ_SQL_SCANNER_CS}"
CONTAINERIZER_SQL_PASSWORD="$(cat "$CREDENTIALS_DIRECTORY/sql-scanner")"
export CONTAINERIZER_SQL_PASSWORD
# opens the source control tokens administrators register on the admin pages
export CONTAINERIZER_CREDENTIAL_KEY_FILE="$CREDENTIALS_DIRECTORY/credential-key"
# the appliance's own registry (localhost:5000, no credentials) is always a valid push target
CONTAINERIZER_WORKER_HOSTS="localhost${CONTAINERIZER_WORKER_HOSTS:+,$CONTAINERIZER_WORKER_HOSTS}"
export CONTAINERIZER_WORKER_HOSTS
export HOME=/var/lib/containerizer/worker
exec /usr/lib/containerizer/venv/bin/python -m containerizer worker --data-dir /var/lib/containerizer/worker \
  --metrics-host 127.0.0.1 --metrics-port 9464
