#!/bin/bash
# The sandbox cluster's secret store and its connection to the output repository of the organization
# scans (sandbox.env). Runs every 2 minutes, so new apps get their credentials without anyone logging in.
#
# - External Secrets Operator (k3s HelmChart external-secrets) reads ClusterSecretStore "app-secrets":
#   Secrets in the locked-down namespace containerizer-secrets (lib/secret-store.sh). Nothing generated
#   is a Secret; this script only puts values into that namespace.
# - The read-only Git token goes there as flux-system--cz-git (the root GitRepository + Kustomization of
#   `containerizer org`, sandbox/flux/bootstrap.yaml, read it through an ExternalSecret) and as
#   <namespace>--cz-git for every app whose GitRepository asks for one (each app reconciles as its own
#   ServiceAccount from its own source; its generated tenant.yaml grants it that key).
set -euo pipefail
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
k() { /usr/bin/k3s kubectl "$@"; }
. /usr/lib/containerizer/lib/secret-store.sh
# Read-only access for the scan worker, which checks the sandbox at the end of each scan (the results pages), and
# the LLM queue runner, which checks the health of "Make it A" variants
# (docs/refactoring.md#the-sandbox-variant): the verifier ServiceAccount of sandbox/verify-rbac.yaml with its
# Role in every namespace containerizer generated (get/list workloads, pods, logs, events and the namespace's
# Flux Kustomization; no Secrets, nothing cluster-wide), and a kubeconfig with a short-lived token of it in
# /run/containerizer/sandbox-verifier.kubeconfig (root:containerizer 0640; renewed every 12 hours).
VERIFIER_KUBECONFIG=/run/containerizer/sandbox-verifier.kubeconfig
verifier_access() {
  local nss token server ca tmp
  nss=$(k get namespaces -l app.kubernetes.io/managed-by=containerizer -o jsonpath='{.items[*].metadata.name}')
  # shellcheck disable=SC2086 # one argument per namespace
  /usr/lib/containerizer/venv/bin/python -I -c 'import sys, yaml
from containerizer.sandbox import verify_rbac
print("---\n".join(yaml.safe_dump(d, sort_keys=False) for d in verify_rbac(sys.argv[1:])))' $nss \
    | k apply -f - >/dev/null
  if [ -s "$VERIFIER_KUBECONFIG" ] && [ -z "$(find "$VERIFIER_KUBECONFIG" -mmin +720)" ]; then return 0; fi
  token=$(k -n containerizer-verify create token containerizer-verifier --duration=24h)
  server=$(k config view --raw -o jsonpath='{.clusters[0].cluster.server}')
  ca=$(k config view --raw -o jsonpath='{.clusters[0].cluster.certificate-authority-data}')
  install -d -m 0755 /run/containerizer
  tmp=$(mktemp "$VERIFIER_KUBECONFIG.XXXXXX")
  cat > "$tmp" <<KUBECONFIG
apiVersion: v1
kind: Config
clusters: [{name: sandbox, cluster: {server: "$server", certificate-authority-data: "$ca"}}]
users: [{name: containerizer-verifier, user: {token: "$token"}}]
contexts: [{name: sandbox, context: {cluster: sandbox, user: containerizer-verifier}}]
current-context: sandbox
KUBECONFIG
  chown root:containerizer "$tmp" && chmod 0640 "$tmp" && mv -f "$tmp" "$VERIFIER_KUBECONFIG"
}
verifier_access || echo "containerizer: the read-only sandbox access for the scan worker and the LLM queue runner is not ready yet; retrying in 2 minutes" >&2

# Read-only access for the egress observer (containerizer-egress-observer, docs/egress.md#the-egress-observer): its
# own ServiceAccount with get/list pods and get pods/log in kube-system (the CoreDNS query log the
# coredns-custom ConfigMap turns on) and get/list pods in every namespace containerizer generated (which pod a
# source address is). No Secrets, no write verbs, nothing cluster-wide. Kubeconfig in
# /run/containerizer/egress-observer.kubeconfig (root:containerizer 0640; a 24-hour token renewed every 12 hours).
OBSERVER_KUBECONFIG=/run/containerizer/egress-observer.kubeconfig
observer_access() {
  local nss token server ca tmp
  nss=$(k get namespaces -l app.kubernetes.io/managed-by=containerizer -o jsonpath='{.items[*].metadata.name}')
  # shellcheck disable=SC2086 # one argument per namespace
  /usr/lib/containerizer/venv/bin/python -I -c 'import sys, yaml
from containerizer.egress import observer_rbac
print("---\n".join(yaml.safe_dump(d, sort_keys=False) for d in observer_rbac(sys.argv[1:])))' $nss \
    | k apply -f - >/dev/null
  if [ -s "$OBSERVER_KUBECONFIG" ] && [ -z "$(find "$OBSERVER_KUBECONFIG" -mmin +720)" ]; then return 0; fi
  token=$(k -n containerizer-verify create token containerizer-egress-observer --duration=24h)
  server=$(k config view --raw -o jsonpath='{.clusters[0].cluster.server}')
  ca=$(k config view --raw -o jsonpath='{.clusters[0].cluster.certificate-authority-data}')
  install -d -m 0755 /run/containerizer
  tmp=$(mktemp "$OBSERVER_KUBECONFIG.XXXXXX")
  cat > "$tmp" <<KUBECONFIG
apiVersion: v1
kind: Config
clusters: [{name: sandbox, cluster: {server: "$server", certificate-authority-data: "$ca"}}]
users: [{name: containerizer-egress-observer, user: {token: "$token"}}]
contexts: [{name: sandbox, context: {cluster: sandbox, user: containerizer-egress-observer}}]
current-context: sandbox
KUBECONFIG
  chown root:containerizer "$tmp" && chmod 0640 "$tmp" && mv -f "$tmp" "$OBSERVER_KUBECONFIG"
}
observer_access || echo "containerizer: the egress observer's read-only sandbox access is not ready yet; retrying in 2 minutes" >&2

if cz_store_ready; then cz_store_setup; fi
# OpenBao (docs/openbao.md): initialised the first time; then an empty entry per secret value each sandbox app
# reads, for administrators and operators to fill in, and the filled values into the store (containerizer.openbao)
if systemctl is-active --quiet containerizer-openbao.service && cz_store_ready; then
  CZ_KUBECTL="/usr/bin/k3s kubectl" /usr/lib/containerizer/venv/bin/python -I -m containerizer.openbao sync \
    || echo "openbao: could not sync the apps' secret values" >&2
fi
# Sandbox HTTPS (Admin -> Sandbox HTTPS): the wildcard certificate as Traefik's default, or none when it is off.
# After the store is set up, so the certificate goes through it; before sandbox.env, which it does not need.
/usr/lib/containerizer/venv/bin/python -m containerizer.sysagent sandbox-https sync >/dev/null \
  || echo "containerizer: the sandbox certificate is not installed in k3s yet; retrying in 2 minutes" >&2
# Where the connection to the output repository stands, for the scan worker's metrics (containerizer_sandbox_connection,
# Grafana's Flux dashboard, alert ContainerizerSandboxNotConnected): one word and why, in a file with no secret in
# it; a change is also logged, so `journalctl -u containerizer-sandbox` says why nothing deploys.
STATUS=/run/containerizer/sandbox-status
sandbox_status() {  # state detail
  local was tmp
  was=$(sed -n 's/^state=//p' "$STATUS" 2>/dev/null || true)
  [ "$was" = "$1" ] || echo "containerizer-sandbox: $1: $2" >&2
  install -d -m 0755 /run/containerizer
  tmp=$(mktemp "$STATUS.XXXXXX")
  printf 'state=%s\nat=%s\ndetail=%s\n' "$1" "$(date +%s)" "$2" > "$tmp"
  chmod 0644 "$tmp" && mv -f "$tmp" "$STATUS"
}
. /etc/containerizer/sandbox.env

if [ -z "${CZ_SANDBOX_GIT_URL:-}" ]; then
  sandbox_status no-repository "CZ_SANDBOX_GIT_URL is empty in /etc/containerizer/sandbox.env: Flux deploys nothing"
  exit 0
fi
case "$CZ_SANDBOX_GIT_URL" in
  https://*) ;;
  *) sandbox_status bad-url "CZ_SANDBOX_GIT_URL in /etc/containerizer/sandbox.env must be an https:// URL"; exit 1;;
esac
if ! cz_store_ready; then
  sandbox_status store-not-ready "External Secrets Operator (namespace external-secrets) is not ready yet"
  exit 0
fi
if ! k get crd gitrepositories.source.toolkit.fluxcd.io kustomizations.kustomize.toolkit.fluxcd.io >/dev/null 2>&1; then
  sandbox_status no-flux "Flux's CRDs are not in k3s yet (namespace flux-system)"
  exit 0
fi

git_token() {  # remote key
  cz_store_put "$1" username="${CZ_SANDBOX_GIT_USERNAME:-git}" password="${CZ_SANDBOX_GIT_TOKEN:-}"
}
legacy_secret() {  # namespace name: output generated before ExternalSecrets (no ExternalSecret of that name)
  k apply -f - >/dev/null <<YAML
apiVersion: v1
kind: Secret
metadata: {name: $2, namespace: $1, labels: {app.kubernetes.io/managed-by: containerizer-appliance}}
data:
  username: $(printf %s "${CZ_SANDBOX_GIT_USERNAME:-git}" | base64 -w0)
  password: $(printf %s "$CZ_SANDBOX_GIT_TOKEN" | base64 -w0)
YAML
}

git_token flux-system--cz-git
cz_store_grant flux-system flux-system--cz-git flux-system--cz-webhook
k apply -f - >/dev/null <<YAML
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: containerizer-sandbox-git
  namespace: flux-system
  labels: {app.kubernetes.io/part-of: containerizer-sandbox, app.kubernetes.io/managed-by: containerizer-appliance}
spec:
  refreshInterval: 1h
  secretStoreRef: {kind: ClusterSecretStore, name: app-secrets}
  target: {name: containerizer-sandbox-git, creationPolicy: Owner, deletionPolicy: Retain}
  dataFrom:
    - extract: {key: flux-system--cz-git}
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: containerizer-sandbox
  namespace: flux-system
  labels: {app.kubernetes.io/part-of: containerizer-sandbox, app.kubernetes.io/managed-by: containerizer-appliance}
spec:
  interval: 5m
  url: ${CZ_SANDBOX_GIT_URL}
  ref: {branch: ${CZ_SANDBOX_GIT_BRANCH:-main}}
  secretRef: {name: containerizer-sandbox-git}
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: containerizer-sandbox
  namespace: flux-system
  labels: {app.kubernetes.io/part-of: containerizer-sandbox, app.kubernetes.io/managed-by: containerizer-appliance}
spec:
  interval: 10m
  retryInterval: 2m
  timeout: 5m
  prune: true
  wait: false
  sourceRef: {kind: GitRepository, name: containerizer-sandbox}
  path: ./sandbox/flux/apps
YAML
if [ -n "${CZ_SANDBOX_GIT_TOKEN:-}" ]; then
  sandbox_status connected "the root sync (flux-system: GitRepository and Kustomization containerizer-sandbox) reads $CZ_SANDBOX_GIT_URL"
else
  sandbox_status no-token "CZ_SANDBOX_GIT_TOKEN is empty in /etc/containerizer/sandbox.env: only a public output repository can be read"
fi
# An application moved to an output repository of its own (Admin -> Applications -> Output repository,
# containerizer/appoutput.py): the LLM queue runner writes that repository's read token to
# $SANDBOX_GIT_DIR/<namespace> (url, user name, token on three lines; 0600, its own user), and its
# namespace's key gets that token instead of the scans' one, for that URL only.
SANDBOX_GIT_DIR=/var/lib/containerizer/refactor/sandbox-git
own_token() {  # namespace url: sets OWN_USER and OWN_PASS when the runner wrote a token for that repository
  local f="$SANDBOX_GIT_DIR/$1" u
  [ -f "$f" ] || return 1
  { read -r u; read -r OWN_USER; read -r OWN_PASS; } < "$f" || return 1
  [ "$u" = "$2" ] && [ -n "$OWN_PASS" ]
}
# every app GitRepository generated by containerizer (same repository URL, or a moved application's own) gets
# the read-only token it names: in the store when its ExternalSecret exists, as a Secret for output generated
# before that
k get gitrepositories.source.toolkit.fluxcd.io -A -l app.kubernetes.io/managed-by=containerizer \
  -o jsonpath='{range .items[*]}{.metadata.namespace}{" "}{.spec.url}{" "}{.spec.secretRef.name}{"\n"}{end}' \
| while read -r ns url name; do
    [ -n "$name" ] && [ "$ns" != flux-system ] || continue
    own=
    if [ "$url" != "$CZ_SANDBOX_GIT_URL" ]; then own_token "$ns" "$url" || continue; own=1; fi
    if k -n "$ns" get externalsecrets.external-secrets.io "$name" >/dev/null 2>&1; then
      new=; k -n "$CZ_STORE_NS" get secret "$ns--cz-git" >/dev/null 2>&1 || new=1
      if [ -n "$own" ]; then
        cz_store_put "$ns--cz-git" username="${OWN_USER:-git}" password="$OWN_PASS"
      else
        git_token "$ns--cz-git"
      fi
      # a new app: sync now rather than after ESO's back-off from the first, failed read
      [ -z "$new" ] || k -n "$ns" annotate --overwrite externalsecrets.external-secrets.io "$name" \
        "force-sync=$(date +%s)" >/dev/null
    elif [ -z "$own" ]; then
      legacy_secret "$ns" "$name"
    fi
  done

# The Flux webhook (containerizer/fluxhook.py, docs/scheduled-scans.md#flux-webhook): Flux polls the output
# repository every 5 minutes; the scan worker and the LLM queue runner call this Receiver after each push so the
# root sync and every app's GitRepository reconcile at once. Its token is made once and kept in the store
# (flux-system--cz-webhook, read by the ExternalSecret containerizer-sandbox-webhook); the Receiver lists the
# GitRepositories containerizer generated in every app namespace (Flux's default flags allow references to other
# namespaces). The URL (the webhook-receiver Service's ClusterIP, reachable from this host only, and the path Flux
# derives from the token) goes to /run/containerizer/flux-webhook (root:containerizer 0640): it is the secret.
WEBHOOK=/run/containerizer/flux-webhook
flux_webhook() {
  local nss ready path ip url tmp
  k get crd receivers.notification.toolkit.fluxcd.io >/dev/null 2>&1 || return 0
  if ! k -n "$CZ_STORE_NS" get secret flux-system--cz-webhook >/dev/null 2>&1; then
    cz_store_put flux-system--cz-webhook token="$(head -c 32 /dev/urandom | sha256sum | cut -d' ' -f1)"
  fi
  nss=$(k get gitrepositories.source.toolkit.fluxcd.io -A -l app.kubernetes.io/managed-by=containerizer \
    -o jsonpath='{.items[*].metadata.namespace}')
  # shellcheck disable=SC2086 # one argument per namespace
  /usr/lib/containerizer/venv/bin/python -I -c 'import sys, yaml
from containerizer.fluxhook import receiver_manifests
print("---\n".join(yaml.safe_dump(d, sort_keys=False) for d in receiver_manifests(sys.argv[1:])))' $nss \
    | k apply -f - >/dev/null
  ready=$(k -n flux-system get receivers.notification.toolkit.fluxcd.io containerizer-sandbox \
    -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}')
  path=$(k -n flux-system get receivers.notification.toolkit.fluxcd.io containerizer-sandbox \
    -o jsonpath='{.status.webhookPath}')
  ip=$(k -n flux-system get service webhook-receiver -o jsonpath='{.spec.clusterIP}')
  if [ "$ready" != True ] || [ -z "$path" ] || [ -z "$ip" ] || [ "$ip" = None ]; then
    rm -f "$WEBHOOK"; return 0      # not ready yet (the ExternalSecret's first read): Flux polls meanwhile
  fi
  url="http://$ip$path"
  [ "$(cat "$WEBHOOK" 2>/dev/null)" != "$url" ] || return 0
  install -d -m 0755 /run/containerizer
  tmp=$(mktemp "$WEBHOOK.XXXXXX")
  printf '%s\n' "$url" > "$tmp"
  chown root:containerizer "$tmp" && chmod 0640 "$tmp" && mv -f "$tmp" "$WEBHOOK"
}
flux_webhook || echo "containerizer: the Flux webhook is not ready yet (Flux polls every 5 minutes meanwhile); retrying in 2 minutes" >&2

# The sandbox identity provider (docs/sandbox-idp.md): once Flux has deployed sandbox/idp, its admin and
# keystore passwords, the test users' passwords and the OIDC client secrets go into the store (made
# once, kept afterwards; each component gets its client secret under its own remote key). Values go to
# kubectl through stdin only. `containerizer idp users` on the console shows the test users' passwords.
if k get namespace containerizer-idp >/dev/null 2>&1; then
  CZ_KUBECTL="/usr/bin/k3s kubectl" /usr/lib/containerizer/venv/bin/python -I -m containerizer idp secrets \
    || echo "sandbox identity provider: could not make its secrets" >&2
fi
