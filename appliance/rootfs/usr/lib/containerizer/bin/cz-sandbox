#!/bin/bash
# Connect the sandbox cluster to the output repository of the organization scans (sandbox.env):
# the read-only Git secret and the root GitRepository + Kustomization of `containerizer org`
# (sandbox/flux/bootstrap.yaml), and the same read-only secret in every app namespace whose GitRepository
# asks for one (each app reconciles as its own ServiceAccount from its own source). Runs every 2 minutes,
# so new apps get their secret without anyone logging in.
set -euo pipefail
. /etc/containerizer/sandbox.env
[ -n "${CZ_SANDBOX_GIT_URL:-}" ] || exit 0
case "$CZ_SANDBOX_GIT_URL" in https://*) ;; *) echo "CZ_SANDBOX_GIT_URL must be an https:// URL" >&2; exit 1;; esac
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
k() { /usr/bin/k3s kubectl "$@"; }
k get crd gitrepositories.source.toolkit.fluxcd.io kustomizations.kustomize.toolkit.fluxcd.io >/dev/null 2>&1 || exit 0

secret() {  # namespace name
  k -n "$1" create secret generic "$2" --from-literal=username="${CZ_SANDBOX_GIT_USERNAME:-git}" \
    --from-literal=password="$CZ_SANDBOX_GIT_TOKEN" --dry-run=client -o yaml \
  | k label --local -f - app.kubernetes.io/managed-by=containerizer-appliance -o yaml \
  | k apply -f - >/dev/null
}
secret flux-system containerizer-sandbox-git
k apply -f - >/dev/null <<YAML
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: containerizer-sandbox
  namespace: flux-system
  labels: {app.kubernetes.io/part-of: containerizer-sandbox, app.kubernetes.io/managed-by: containerizer-appliance}
spec:
  interval: 5m
  url: ${CZ_SANDBOX_GIT_URL}
  ref: {branch: ${CZ_SANDBOX_GIT_BRANCH:-main}}
  secretRef: {name: containerizer-sandbox-git}
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: containerizer-sandbox
  namespace: flux-system
  labels: {app.kubernetes.io/part-of: containerizer-sandbox, app.kubernetes.io/managed-by: containerizer-appliance}
spec:
  interval: 10m
  retryInterval: 2m
  timeout: 5m
  prune: true
  wait: false
  sourceRef: {kind: GitRepository, name: containerizer-sandbox}
  path: ./sandbox/flux/apps
YAML
# every app GitRepository generated by containerizer (same repository URL) gets the read-only secret it names
k get gitrepositories.source.toolkit.fluxcd.io -A -l app.kubernetes.io/managed-by=containerizer \
  -o jsonpath='{range .items[*]}{.metadata.namespace}{" "}{.spec.url}{" "}{.spec.secretRef.name}{"\n"}{end}' \
| while read -r ns url name; do
    [ "$url" = "$CZ_SANDBOX_GIT_URL" ] && [ -n "$name" ] && [ "$ns" != flux-system ] || continue
    secret "$ns" "$name"
  done
