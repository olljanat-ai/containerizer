#!/bin/bash
# On the live ISO: the installer (the disk, an optional SSH key for root and the host name). Installed:
# nothing, the console shows the normal login prompt.
set -uo pipefail
TTY="${1:-tty1}"

ask_key() {  # optional: root signs in with the password too
  echo "  SSH public key to sign in as root with (one line: ssh-ed25519, ecdsa-sha2-* or ssh-rsa;"
  echo "  empty: none, sign in with the password \"containerizer\" and change it at the first sign-in):"
  echo
  : > /run/cz-key.pub
  while :; do
    read -r -p "  key> " key || exit 0
    [ -n "$key" ] || return 0
    printf '%s\n' "$key" > /run/cz-key.pub
    if ssh-keygen -l -f /run/cz-key.pub >/dev/null 2>&1; then break; fi
    echo "  That is not an SSH public key. Try again."
  done
}

# ----------------------------------------------------------------------------- live ISO: the installer
if grep -qw cdroot /proc/cmdline; then
  # only one console runs the installer
  exec 9>/run/cz-installer.lock
  flock -n 9 || exit 0
  exec </dev/"$TTY" >/dev/"$TTY" 2>&1
  clear 2>/dev/null || true
  echo
  echo "  containerizer appliance $(. /etc/os-release; echo "$IMAGE_TAG") - installer"
  echo
  echo "  Disks (everything on the chosen disk is erased; at least 64 GB recommended):"
  lsblk -dpno NAME,SIZE,MODEL,TYPE | awk '$NF == "disk" {print "    " $0}'
  echo
  while :; do
    read -r -p "  Install to (e.g. /dev/sda, /dev/vda, /dev/nvme0n1; empty: cancel): " disk || exit 0
    [ -n "$disk" ] || { echo "  Cancelled. Restart the machine to start the installer again."; exit 0; }
    [ "$(lsblk -dno TYPE "$disk" 2>/dev/null)" = disk ] && break
    echo "  $disk is not a disk."
  done
  ask_key
  read -r -p "  Host name (empty: containerizer): " name
  [[ "${name:-x}" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] || name=""
  { echo "name: containerizer installer"
    echo "stages:"
    echo "  initramfs:"
    echo "    - name: host name"
    echo "      hostname: \"${name:-containerizer}\""
    if [ -s /run/cz-key.pub ]; then
      echo "  fs:"
      echo "    - name: SSH key of the administrator"
      echo "      authorized_keys:"
      echo "        root:"
      echo "        - \"$(cat /run/cz-key.pub)\""
    fi
  } > /run/cz-install.yaml
  echo
  read -r -p "  Erase $disk and install? Type yes: " ok
  [ "$ok" = yes ] || { echo "  Cancelled."; exit 0; }
  if elemental install --eject-cd --cloud-init /run/cz-install.yaml "$disk"; then
    echo "  Installed. Remove the ISO; restarting in 10 seconds."
    sleep 10
    systemctl reboot
  else
    echo "  The installation failed; the log is above. Restart the machine to try again."
  fi
  exit 0
fi

# ----------------------------------------------------------------------------- installed: the normal login
# prompt (root's password is "containerizer" until changed; login asks for a new one, see cz-root-password)
exit 0
