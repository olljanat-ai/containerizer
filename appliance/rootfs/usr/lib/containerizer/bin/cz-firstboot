#!/bin/bash
# containerizer appliance, every boot before anything else: configuration files from the defaults, generated
# secrets, data folders with their owners, and the per-boot settings derived from appliance.env.
# Idempotent: existing files are never overwritten.
set -euo pipefail
umask 077
C=/etc/containerizer
S=$C/secrets
D=/var/lib/containerizer
DEF=/usr/lib/containerizer/defaults

# the appliance's runtime folders and the /etc/resolv.conf link (systemd-tmpfiles-setup creates them too;
# a boot was seen without them, and the web UI cannot start without /run/containerizer/system/requests)
systemd-tmpfiles --create /usr/lib/tmpfiles.d/containerizer.conf /usr/lib/tmpfiles.d/00-containerizer-resolv.conf || true
install -d -m 0700 -o root -g root "$C" "$S"
for f in appliance.env web.env worker.env sandbox.env grafana.env egress.json; do
  [ -e "$C/$f" ] || install -m 0600 -o root -g root "$DEF/$f" "$C/$f"
done
[ -d "$C/network" ] || install -d -m 0755 "$C/network"

# SQL Server passwords: 32 random characters plus one of each class its policy asks for
secret() { [ -s "$S/$1" ] || { printf '%s' "$(head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32)Aa1!" > "$S/$1"; chmod 0400 "$S/$1"; }; }
for n in mssql-sa cz-scanner cz-web cz-admin cz-grafana grafana-admin; do secret "$n"; done
printf 'MSSQL_SA_PASSWORD=%s\n' "$(cat $S/mssql-sa)" > "$S/mssql.env"
# CZ_GRAFANA_SQL_PASSWORD: Grafana's results database login cz_grafana (role usage: the LLM usage views only)
printf 'GF_SECURITY_ADMIN_USER=admin\nGF_SECURITY_ADMIN_PASSWORD=%s\nCZ_GRAFANA_SQL_PASSWORD=%s\n' \
  "$(cat $S/grafana-admin)" "$(cat $S/cz-grafana)" > "$S/grafana.env"
chmod 0400 "$S/mssql.env" "$S/grafana.env"
# Source control tokens (Admin → Source control) are sealed for the scan worker's key: the web UI gets only the
# public key. Never replaced: tokens sealed for the old key would no longer open.
if [ ! -s "$S/credential-key" ]; then
  rm -f "$S/credential-key.pub"
  /usr/lib/containerizer/venv/bin/python -m containerizer credentials keygen \
    --private "$S/credential-key" --public "$S/credential-key.pub" >/dev/null
  chmod 0400 "$S/credential-key" "$S/credential-key.pub"
fi

install -d -m 0755 -o root -g root "$D" "$D/system"
install -d -m 0770 -o 10001 -g 0 "$D/mssql"
install -d -m 0700 -o 65532 -g 65532 "$D/registry"
install -d -m 0700 -o 65534 -g 65534 "$D/prometheus"
install -d -m 0700 -o 472 -g 0 "$D/grafana"
install -d -m 0700 -o containerizer -g containerizer "$D/worker"
# the LLM answer cache, shared by the scan worker and the LLM queue runner (which may write only there and in
# its refactoring scratch space)
install -d -m 0700 -o containerizer -g containerizer "$D/worker/ai-cache"
install -d -m 0700 -o containerizer -g containerizer "$D/refactor"
# dev database backups (Admin -> Dev databases): the web UI writes them, the scan worker (group) reads them
install -d -m 2750 -o cz-web -g containerizer "$D/devdb"

# static networks: /etc/containerizer/network/*.network take precedence over DHCP
if compgen -G "$C/network/*.network" >/dev/null; then
  # a static address 0.13.x wrote for bond0 is for br0 since 0.14.0 (bond0 is the bridge's port; netconfig.migrate)
  for f in "$C"/network/*.network; do
    if head -1 "$f" | grep -qF "# Containerizer: the appliance's static address (python -m containerizer.sysagent" \
        && grep -qx 'Name=bond0' "$f"; then
      sed -i -e "1s/.*/# Containerizer: the appliance's static address (cz network static ...)./" \
        -e 's/^Name=bond0$/Name=br0/' "$f"
    fi
  done
  install -d /run/systemd/network
  # readable for systemd-networkd, which runs as systemd-network (cp under umask 077 left them 0600: ignored)
  install -m 0644 "$C"/network/*.network /run/systemd/network/
fi

set -a
. "$C/appliance.env"
set +a
# the web UI's name (a DNS name, e.g. an FQDN); it does not rename the machine: the host name (the installer's,
# else "containerizer") is the sandbox cluster's node name too, and k3s would register a second node
host="${CZ_HOSTNAME:-$(hostname)}"
install -d -m 0755 /run/containerizer
# Caddy: the certificate covers the name and the addresses (added by cz-addresses once DHCP is done).
# Certificate: your own (/etc/containerizer/tls/cert.pem with its chain, and key.pem), else Let's Encrypt
# (CZ_ACME_EMAIL), else Caddy's own CA. Caddy (group caddy) cannot read /etc/containerizer: a copy in /run.
T=$C/tls
R=/run/containerizer/tls
rm -rf "$R"
if [ -s "$T/cert.pem" ] && [ -s "$T/key.pem" ]; then
  install -d -m 0750 -o root -g caddy "$R"
  install -m 0644 -o root -g caddy "$T/cert.pem" "$R/cert.pem"
  install -m 0640 -o root -g caddy "$T/key.pem" "$R/key.pem"
  [ -z "${CZ_ACME_EMAIL:-}" ] || echo "cz-firstboot: $T has a certificate: CZ_ACME_EMAIL is not used" >&2
elif [ -e "$T/cert.pem" ] || [ -e "$T/key.pem" ]; then
  echo "cz-firstboot: $T needs both cert.pem and key.pem: not used" >&2
fi
{
  echo "CZ_SITES=https://$host"
  if [ -s "$R/key.pem" ]; then
    echo "CZ_CADDY_TLS=$R/cert.pem $R/key.pem"
    echo "CZ_CADDY_ACME="
  elif [ -n "${CZ_ACME_EMAIL:-}" ]; then
    echo "CZ_CADDY_TLS=$CZ_ACME_EMAIL"
    echo "CZ_CADDY_ACME=email $CZ_ACME_EMAIL"
  else
    echo "CZ_CADDY_TLS=internal"
    echo "CZ_CADDY_ACME="
  fi
} > /run/containerizer/caddy.env
echo "CONTAINERIZER_PUBLIC_URL=https://$host" > /run/containerizer/web-url.env
echo "GF_SERVER_ROOT_URL=https://$host/grafana/" > /run/containerizer/grafana-url.env
# Grafana with sign-in through an identity provider (GF_AUTH_<provider>_ENABLED=true in grafana.env): no user
# name and password form, straight to the provider. Set in grafana.env, either setting is left to it.
sso=$(grep -Eio '^GF_AUTH_(GENERIC_OAUTH|AZUREAD|GOOGLE|GITHUB|GITLAB|OKTA)_ENABLED=["'"'"']?true' "$C/grafana.env" \
  | sed -E 's/^GF_AUTH_(.*)_ENABLED=.*/\1/' | tr '[:lower:]' '[:upper:]' || true)
if [ -n "$sso" ]; then
  for kv in GF_AUTH_DISABLE_LOGIN_FORM=true $(for p in $sso; do echo "GF_AUTH_${p}_AUTO_LOGIN=true"; done); do
    grep -q "^${kv%%=*}=" "$C/grafana.env" || echo "$kv" >> /run/containerizer/grafana-url.env
  done
fi
echo "CONTAINERIZER_GRAFANA_URL=https://$host/grafana/d/containerizer-scans" >> /run/containerizer/web-url.env
# LLM-heavy mode (docs/platform-migration.md): off unless appliance.env turns it on; the web UI shows it, the
# worker only uses it for scans that have it ticked too
case "${CZ_LLM_HEAVY:-false}" in true|yes|1|on) llm_heavy=true;; *) llm_heavy=false;; esac
echo "CONTAINERIZER_LLM_HEAVY=$llm_heavy" > /run/containerizer/llm.env
# Results database: SQL Server on the appliance, or the external one of CZ_SQL_SERVER (the local one does not
# start then). /run/containerizer/sql.env has the connection strings of cz-db-init, the web UI and the worker.
rm -f /run/containerizer/sql-external /run/containerizer/sql.env /run/containerizer/sql-ca.pem
[ -z "${CZ_SQL_SERVER:-}" ] || touch /run/containerizer/sql-external
/usr/lib/containerizer/venv/bin/python -m containerizer.sysagent sql-env ||
  echo "containerizer: the results database settings (CZ_SQL_*) in $C/appliance.env are not valid;" \
    "the web UI and the scan worker do not start until they are fixed and the appliance restarted" >&2
chmod 0644 /run/containerizer/caddy.env /run/containerizer/web-url.env /run/containerizer/grafana-url.env \
  /run/containerizer/llm.env

# kubemg (optional, CZ_KUBEMG=true): its secrets (kept when it is turned off: the database is encrypted with the
# secret key), data folders, settings and Caddy site. /run/containerizer/kubemg/kubemg.env starts its services.
rm -rf /run/containerizer/kubemg /run/containerizer/kubemg.caddy
case "${CZ_KUBEMG:-false}" in true|yes|1|on) kubemg=true;; *) kubemg=false;; esac
if [ "$kubemg" = true ]; then
  key() { [ -s "$S/$1" ] || { head -c 32 /dev/urandom | base64 > "$S/$1"; chmod 0400 "$S/$1"; }; }
  secret kubemg-db; secret kubemg-admin; key kubemg-secret-key; key kubemg-recording-key
  rm -f "$S/kubemg-db.env" "$S/kubemg.env"
  printf 'POSTGRES_PASSWORD=%s\n' "$(cat $S/kubemg-db)" > "$S/kubemg-db.env"
  printf 'DB_PASSWORD=%s\nKUBEMG_ADMIN_PASSWORD=%s\nKUBEMG_SECRET_KEY=%s\nKUBEMG_SESSION_RECORDING_KEY=%s\n' \
    "$(cat $S/kubemg-db)" "$(cat $S/kubemg-admin)" "$(cat $S/kubemg-secret-key)" "$(cat $S/kubemg-recording-key)" \
    > "$S/kubemg.env"
  chmod 0400 "$S/kubemg-db.env" "$S/kubemg.env"
  install -d -m 0755 -o root -g root "$D/kubemg"
  install -d -m 0700 -o 70 -g 70 "$D/kubemg/postgres"
  install -d -m 0700 -o 65532 -g 65532 "$D/kubemg/recordings"
  # kubemg serves HTTPS on loopback too (its setup refuses plain HTTP: kubectl would not send a token over it), with
  # a certificate of a local CA that only Caddy trusts. Made once; the CA's key never leaves root.
  KT=$D/kubemg/tls
  /usr/lib/containerizer/venv/bin/python -m containerizer.kubemg loopback-tls --dir "$KT" --group 65532
  khost="${CZ_KUBEMG_HOSTNAME:-kubemg.$host}"
  install -d -m 0755 /run/containerizer/kubemg
  install -m 0644 "$KT/ca.crt" /run/containerizer/kubemg/loopback-ca.pem
  printf 'CZ_KUBEMG_HOST=%s\nKUBEMG_PUBLIC_URL=https://%s\nCZ_ACME_EMAIL=%s\n' "$khost" "$khost" "${CZ_ACME_EMAIL:-}" \
    > /run/containerizer/kubemg/kubemg.env
  # its own site in Caddy, with the appliance's certificate settings (the certificate must cover the name)
  cat > /run/containerizer/kubemg.caddy <<CADDY
https://$khost {
	tls {\$CZ_CADDY_TLS}
	encode zstd gzip
	header -Server
	reverse_proxy https://127.0.0.1:8444 {
		transport http {
			tls_trusted_ca_certs /run/containerizer/kubemg/loopback-ca.pem
		}
	}
	log {
		output stderr
		format console
	}
}
CADDY
  chmod 0644 /run/containerizer/kubemg/kubemg.env /run/containerizer/kubemg.caddy
  echo "CONTAINERIZER_KUBEMG_URL=https://$khost/" >> /run/containerizer/web-url.env
fi

# Learned rules: the code reads and writes rules/learned/, which on the appliance is a link to the
# persistent partition. The OS image ships the project's learned rules in learned-seed/. A file nobody
# changed locally follows the image; a file the worker added to keeps the local copy, and the image's
# version is put next to it as <file>.shipped.
L=$D/learned
SEED=/usr/lib/containerizer/learned-seed
install -d -m 0755 -o containerizer -g containerizer "$L" "$L/.seed"
for s in "$SEED"/*.yaml; do
  [ -e "$s" ] || continue
  f=$(basename "$s")
  if [ ! -e "$L/$f" ] || cmp -s "$L/$f" "$L/.seed/$f"; then
    install -m 0644 -o containerizer -g containerizer "$s" "$L/$f"
    rm -f "$L/$f.shipped"
  elif ! cmp -s "$s" "$L/.seed/$f"; then
    install -m 0644 -o containerizer -g containerizer "$s" "$L/$f.shipped"
  fi
  install -m 0644 -o containerizer -g containerizer "$s" "$L/.seed/$f"
done

# The configuration without its secrets, for the output repositories (containerizer.configbackup): staged at every
# boot (the files change only by hand, and a reboot applies them); the LLM queue runner commits it when it changed.
/usr/lib/containerizer/venv/bin/python -I -m containerizer.configbackup collect >/dev/null \
  || echo "containerizer: the configuration backup could not be staged" >&2
