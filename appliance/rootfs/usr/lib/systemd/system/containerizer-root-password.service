[Unit]
Description=containerizer appliance: root's password (default, or the one set at the first sign-in)
After=local-fs.target containerizer-firstboot.service
Before=ssh.service systemd-user-sessions.service getty@tty1.service serial-getty@ttyS0.service
ConditionKernelCommandLine=!cdroot

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/containerizer/bin/cz-root-password restore
# saved again at shutdown, in case a change came after the last save
ExecStop=/usr/lib/containerizer/bin/cz-root-password save

[Install]
WantedBy=multi-user.target
