[Unit]
Description=containerizer appliance: scan worker (scheduled organization scans)
After=containerizer-db-init.service docker.service containerizer-dns.service containerizer-registry.service containerizer-docker-guard.socket
Requires=containerizer-db-init.service docker.service containerizer-docker-guard.socket
Wants=containerizer-registry.service
ConditionKernelCommandLine=!cdroot
ConditionPathExists=!/run/elemental/recovery_mode

[Service]
User=containerizer
Group=containerizer
# Docker through the guard (containerizer/dockerguard.py), not Docker's own socket: the docker group is
# root-equivalent, and the worker builds and runs the scanned repositories' code (docs/appliance-admin.md#builds-of-scanned-code)
Environment=DOCKER_HOST=unix:///run/containerizer/docker-guard.sock
EnvironmentFile=/etc/containerizer/worker.env
# LLM-heavy mode from appliance.env (cz-firstboot), off by default
EnvironmentFile=-/run/containerizer/llm.env
# the built-in LLM (Admin -> Source control & LLM): used while it is on and no LLM is registered
Environment=CONTAINERIZER_LOCAL_LLM=/run/containerizer/system/local-llm-status.json
# lab services that are on (Admin -> Lab services): the scans point the apps at them
Environment=CONTAINERIZER_LAB_SERVICES=/var/lib/containerizer/system/lab-services.json
# dev database backups the web UI stored (read through the group of the folder)
Environment=CONTAINERIZER_DEV_DB_DIR=/var/lib/containerizer/devdb
# LLM answers, so a repeated question costs nothing (the default, next to the code, is the read-only OS image)
Environment=CONTAINERIZER_AI_CACHE=/var/lib/containerizer/worker/ai-cache
# scratch space of builds, verification runs and the image scanner's cache (the code is read-only)
Environment=CONTAINERIZER_WORK=/var/lib/containerizer/worker/work
# the sandbox check at the end of a scan (results pages, "Sandbox cluster"): the read-only verifier kubeconfig
# cz-sandbox writes (containerizer-sandbox.timer); off while it is missing or the sandbox is not connected
Environment=CONTAINERIZER_SANDBOX_KUBECONFIG=/run/containerizer/sandbox-verifier.kubeconfig
# after each push to the output repository: the Flux webhook URL cz-sandbox writes (containerizer/fluxhook.py)
Environment=CONTAINERIZER_FLUX_WEBHOOK=/run/containerizer/flux-webhook
# results database (CZ_SQL_SCANNER_CS): the appliance's own or CZ_SQL_SERVER (cz-firstboot)
# package feeds that need a sign-in (Admin -> Source control): its builds reach them through its feed proxy, which
# adds the tokens; the firewall lets Docker's bridges reach this port only (containerizer/feedproxy.py)
Environment=CONTAINERIZER_FEED_PROXY_LISTEN=169.254.53.53:3128
EnvironmentFile=/run/containerizer/sql.env
LoadCredential=sql-scanner:/etc/containerizer/secrets/cz-scanner
LoadCredential=credential-key:/etc/containerizer/secrets/credential-key
WorkingDirectory=/var/lib/containerizer/worker
ExecStart=/usr/lib/containerizer/bin/cz-worker
# SIGTERM stops the run: its LLM calls at once (the connection to the LLM server is closed), and the run ends after the
# step it is on. A reboot waits at most 2 minutes for that (it waited up to 2 hours for the whole repository before);
# a run cut off is marked failed at the next start and the next run processes every repository again.
KillSignal=SIGTERM
TimeoutStopSec=2min
Restart=on-failure
RestartSec=30
# The worker builds and runs the scanned repositories' images through the Docker socket guard (no privileged
# containers, no host network, mounts from its own folder only); builds and runs sit on Docker's bridges, which the
# firewall keeps away from the appliance's services and the k3s networks (docs/appliance-admin.md#builds-of-scanned-code).
NoNewPrivileges=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
