[Unit]
Description=containerizer appliance: LLM queue runner (queued LLM reviews, refactoring patches; Admin -> LLM queue)
After=containerizer-db-init.service containerizer-dns.service docker.service containerizer-registry.service containerizer-docker-guard.socket
Requires=containerizer-db-init.service
# refactoring patches are built and run before they are offered; without Docker they are "applies only".
# "Make it A" variants push their images to the appliance's registry, as the scan worker does.
Wants=docker.service containerizer-registry.service containerizer-docker-guard.socket
ConditionKernelCommandLine=!cdroot
ConditionPathExists=!/run/elemental/recovery_mode

[Service]
User=containerizer
Group=containerizer
# the sandbox's ingress controller (k3s' Traefik, var/lib/rancher/k3s/server/manifests/containerizer-traefik.yaml)
# runs in kube-system: the generated NetworkPolicies let that namespace call the service ports (docs/egress.md#inbound)
Environment=CONTAINERIZER_INGRESS_NAMESPACE=kube-system
# Docker, to build and run a refactoring patch's components (the verify step of the scan worker): through the
# Docker socket guard, as the scan worker (containerizer/dockerguard.py), since the patched code is the scanned
# repositories' own code, built and run in the same hardened containers (docs/refactoring.md#on-the-appliance).
Environment=DOCKER_HOST=unix:///run/containerizer/docker-guard.sock
# the scan worker's settings: a self-hosted LLM set in the environment (CONTAINERIZER_LLM_*) applies here too
EnvironmentFile=/etc/containerizer/worker.env
EnvironmentFile=-/run/containerizer/llm.env
# the built-in LLM (Admin -> Source control & LLM): used while it is on and no LLM is registered
Environment=CONTAINERIZER_LOCAL_LLM=/run/containerizer/system/local-llm-status.json
# the scan worker's answer cache: an answer the runner gets is found by the next scan
Environment=CONTAINERIZER_AI_CACHE=/var/lib/containerizer/worker/ai-cache
# refactoring patches: the source is read from the scan worker's clones (scan-<id>/repos/<app>, read only:
# a scratch copy is made with `git clone --shared`), the scratch copies and builds go to its own folder
Environment=CONTAINERIZER_REFACTOR_SOURCES=/var/lib/containerizer/worker
Environment=CONTAINERIZER_REFACTOR_WORK=/var/lib/containerizer/refactor
Environment=CONTAINERIZER_WORK=/var/lib/containerizer/refactor/work
Environment=DOCKER_CONFIG=/var/lib/containerizer/refactor/.docker
# "Make it A": a patched copy that rates A and runs is deployed to the sandbox beside the original
# (docs/refactoring.md#the-sandbox-variant): its files are committed to the scan's output repository from a
# clone under the scratch space (the write token: the registered credential, opened with the credential key);
# the lab services that are on give it its own, empty lab database; its health is read back with the
# read-only verifier kubeconfig cz-sandbox writes (containerizer-sandbox.timer); a variant stays until a scan
# assesses newer code of its application, or until someone removes it
Environment=CONTAINERIZER_LAB_SERVICES=/var/lib/containerizer/system/lab-services.json
Environment=CONTAINERIZER_SANDBOX_KUBECONFIG=/run/containerizer/sandbox-verifier.kubeconfig
# after each push to the output repository: the Flux webhook URL cz-sandbox writes (containerizer/fluxhook.py)
Environment=CONTAINERIZER_FLUX_WEBHOOK=/run/containerizer/flux-webhook
# results database (CZ_SQL_SCANNER_CS): the appliance's own or CZ_SQL_SERVER (cz-firstboot)
# package feeds that need a sign-in (Admin -> Source control): its builds reach them through its feed proxy, which
# adds the tokens; the firewall lets Docker's bridges reach this port only (containerizer/feedproxy.py)
Environment=CONTAINERIZER_FEED_PROXY_LISTEN=169.254.53.53:3129
EnvironmentFile=/run/containerizer/sql.env
LoadCredential=sql-scanner:/etc/containerizer/secrets/cz-scanner
# opens the LLM registered under Admin -> Source control & LLM, as the scan worker does
LoadCredential=credential-key:/etc/containerizer/secrets/credential-key
WorkingDirectory=/var/lib/containerizer/worker
ExecStart=/usr/lib/containerizer/bin/cz-llm-queue
# the job it is asking goes back to the queue
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
# Everything is read only (the scan worker's clones too) except the answer cache and the refactoring scratch
# space (cz-firstboot creates both).
ProtectSystem=strict
ReadWritePaths=/var/lib/containerizer/worker/ai-cache /var/lib/containerizer/refactor
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
