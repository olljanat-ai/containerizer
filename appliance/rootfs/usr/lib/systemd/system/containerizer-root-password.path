[Unit]
Description=containerizer appliance: save root's password when it changes
After=containerizer-root-password.service
Requires=containerizer-root-password.service
ConditionPathExists=!/run/elemental/recovery_mode
ConditionKernelCommandLine=!cdroot

[Path]
PathChanged=/etc/shadow
Unit=containerizer-root-password-save.service

[Install]
WantedBy=multi-user.target
