[Unit]
Description=containerizer appliance: built-in LLM on 127.0.0.1:8082, each request to the least busy llama.cpp server (Admin -> Source control & LLM)
After=containerizer-firstboot.service
ConditionKernelCommandLine=!cdroot
ConditionPathExists=!/run/elemental/recovery_mode
# Off by default and not enabled: the system agent writes this file (the servers' ports) and starts the unit with
# the servers (containerizer-local-llm@<n>.service) only while an administrator has turned the built-in LLM on
# (containerizer/local_llm.py); without it a start is skipped, not failed.
ConditionPathExists=/run/containerizer/local-llm.env

[Service]
EnvironmentFile=/run/containerizer/local-llm.env
# A Caddy of its own, apart from the one of the admin pages: least connections first, a server still loading its
# model (llama.cpp answers /health with 503) gets no request.
ExecStart=/usr/bin/caddy run --config /usr/lib/containerizer/local-llm-front.caddy --adapter caddyfile
DynamicUser=yes
Environment=HOME=/tmp XDG_DATA_HOME=/tmp XDG_CONFIG_HOME=/tmp
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
Restart=always
RestartSec=10
