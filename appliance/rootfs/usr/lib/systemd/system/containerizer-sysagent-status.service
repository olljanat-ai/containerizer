[Unit]
Description=containerizer appliance: publish version, snapshots and firewall state
After=containerizer-firstboot.service containerizer-dns.service
ConditionKernelCommandLine=!cdroot
ConditionPathExists=!/run/elemental/recovery_mode

[Service]
Type=oneshot
ExecStart=/usr/lib/containerizer/venv/bin/python -m containerizer.sysagent status
# a oneshot has no start timeout by default, and containerizer-web is ordered after this unit: a run that hangs
# (a network or database call) would hold `systemctl start containerizer-web` forever, with nothing in its journal
TimeoutStartSec=10min
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
