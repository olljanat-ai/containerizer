[Unit]
Description=containerizer appliance: web UI and API
After=containerizer-db-init.service containerizer-dns.service containerizer-sysagent-status.service
Requires=containerizer-db-init.service
ConditionKernelCommandLine=!cdroot
ConditionPathExists=!/run/elemental/recovery_mode

[Service]
User=cz-web
Group=cz-web
# CONTAINERIZER_PUBLIC_URL from CZ_HOSTNAME (cz-firstboot); web.env may override it
EnvironmentFile=-/run/containerizer/web-url.env
EnvironmentFile=/etc/containerizer/web.env
# LLM-heavy mode from appliance.env (cz-firstboot), off by default
EnvironmentFile=-/run/containerizer/llm.env
# results database (CZ_SQL_WEB_CS, CZ_SQL_ADMIN_CS): the appliance's own or CZ_SQL_SERVER (cz-firstboot)
EnvironmentFile=/run/containerizer/sql.env
Environment=CONTAINERIZER_SYSTEM_DIR=/run/containerizer/system
# dev database backups (Admin -> Dev databases), read by the scan worker
Environment=CONTAINERIZER_DEV_DB_DIR=/var/lib/containerizer/devdb
LoadCredential=sql-web:/etc/containerizer/secrets/cz-web
LoadCredential=sql-admin:/etc/containerizer/secrets/cz-admin
LoadCredential=credential-public-key:/etc/containerizer/secrets/credential-key.pub
ExecStart=/usr/lib/containerizer/bin/cz-web
Restart=always
RestartSec=5
# hardening: no privileges, read-only system, only the request and dev database folders writable
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/run/containerizer/system/requests /var/lib/containerizer/devdb
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0027

[Install]
WantedBy=multi-user.target
