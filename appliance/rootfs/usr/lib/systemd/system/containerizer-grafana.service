[Unit]
Description=containerizer appliance: Grafana (https://<appliance>/grafana/)
After=docker.service containerizer-prometheus.service containerizer-dns.service
Requires=docker.service
ConditionKernelCommandLine=!cdroot
ConditionPathExists=!/run/elemental/recovery_mode

[Service]
EnvironmentFile=/usr/lib/containerizer/images.env
ExecStartPre=-/usr/bin/docker rm -f cz-grafana
ExecStart=/usr/bin/docker run --rm --name cz-grafana --network host \
  --env-file /etc/containerizer/grafana.env \
  --env-file /etc/containerizer/secrets/grafana.env \
  --env-file /run/containerizer/grafana-url.env \
  --env GF_SERVER_HTTP_ADDR=127.0.0.1 --env GF_SERVER_HTTP_PORT=3000 \
  --env GF_SERVER_SERVE_FROM_SUB_PATH=true \
  --env GF_PATHS_PROVISIONING=/etc/grafana/provisioning \
  --env GF_ANALYTICS_REPORTING_ENABLED=false --env GF_ANALYTICS_CHECK_FOR_UPDATES=false \
  --env GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false --env GF_NEWS_NEWS_FEED_ENABLED=false \
  --env GF_PLUGINS_PREINSTALL_DISABLED=true \
  --env GF_SECURITY_COOKIE_SECURE=true --env GF_SECURITY_DISABLE_GRAVATAR=true \
  --env GF_USERS_ALLOW_SIGN_UP=false --env GF_AUTH_ANONYMOUS_ENABLED=false \
  --volume /usr/lib/containerizer/grafana/provisioning:/etc/grafana/provisioning:ro \
  --volume /usr/lib/containerizer/grafana/dashboards:/var/lib/grafana-dashboards:ro \
  --volume /var/lib/containerizer/grafana:/var/lib/grafana \
  --user 472:472 --read-only --tmpfs /tmp:size=64m --cap-drop ALL --security-opt no-new-privileges \
  ${CZ_IMAGE_GRAFANA}
ExecStop=/usr/bin/docker stop cz-grafana
Restart=always
# image pulls count against Docker Hub's rate limit: do not retry in a tight loop
RestartSec=30
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
