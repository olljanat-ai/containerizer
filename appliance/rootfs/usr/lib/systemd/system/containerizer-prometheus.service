[Unit]
Description=containerizer appliance: Prometheus (scan worker, k3s and Flux metrics)
After=docker.service containerizer-firstboot.service containerizer-dns.service
Requires=docker.service
ConditionKernelCommandLine=!cdroot
ConditionPathExists=!/run/elemental/recovery_mode

[Service]
EnvironmentFile=/usr/lib/containerizer/images.env
ExecStartPre=-/usr/bin/docker rm -f cz-prometheus
# the k3s token and CA (containerizer-prometheus-k8s.service writes them when k3s is up; read at every scrape)
ExecStartPre=/usr/bin/install -d -m 0750 -o root -g 65534 /run/containerizer/prometheus-k8s
# the built-in LLM's servers (one per NUMA node; containerizer/local_llm.py writes the list, empty while it is off)
ExecStartPre=/usr/bin/install -d -m 0755 /run/containerizer/prometheus-sd
ExecStartPre=/bin/sh -c 'test -e /run/containerizer/prometheus-sd/local-llm.json || echo [] > /run/containerizer/prometheus-sd/local-llm.json'
ExecStart=/usr/bin/docker run --rm --name cz-prometheus --network host \
  --volume /usr/lib/containerizer/prometheus:/etc/prometheus:ro \
  --volume /var/lib/containerizer/prometheus:/prometheus \
  --volume /run/containerizer/prometheus-k8s:/etc/prometheus-k8s:ro \
  --volume /run/containerizer/prometheus-sd:/etc/prometheus-sd:ro \
  --user 65534:65534 --read-only --cap-drop ALL --security-opt no-new-privileges \
  ${CZ_IMAGE_PROMETHEUS} \
  --config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/prometheus \
  --storage.tsdb.retention.time=90d --web.listen-address=127.0.0.1:9090
ExecStop=/usr/bin/docker stop cz-prometheus
Restart=always
# image pulls count against Docker Hub's rate limit: do not retry in a tight loop
RestartSec=30
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
