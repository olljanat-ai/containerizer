[Unit]
Description=containerizer appliance: configuration, secrets and data folders
DefaultDependencies=no
After=local-fs.target systemd-sysusers.service systemd-tmpfiles-setup.service
# systemd-networkd itself too, not only through network-pre.target: a boot that had already reached it started
# networkd before this copied the static address file (/etc/containerizer/network), and br0 got DHCP instead
Before=containerizer-firewall.service network-pre.target sysinit.target systemd-networkd.service
Wants=network-pre.target
ConditionPathExists=!/run/elemental/recovery_mode
ConditionKernelCommandLine=!cdroot

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/containerizer/bin/cz-firstboot
UMask=0077

[Install]
WantedBy=sysinit.target
