[Unit]
Description=k3s: the sandbox cluster (single node; Flux deploys the scanned apps here)
Documentation=https://docs.k3s.io
Wants=network-online.target
After=network-online.target containerizer-dns.service containerizer-firewall.service
ConditionKernelCommandLine=!cdroot
ConditionPathExists=!/run/elemental/recovery_mode

[Service]
Type=notify
EnvironmentFile=-/etc/containerizer/k3s.env
KillMode=process
Delegate=yes
User=root
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStartPre=-/sbin/modprobe overlay
ExecStart=/usr/bin/k3s server

[Install]
WantedBy=multi-user.target
