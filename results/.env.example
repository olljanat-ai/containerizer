# Copy to results/.env and replace every value. SQL Server requires 8+ characters with three of:
# upper case, lower case, digits, symbols. results/.env is git-ignored.
MSSQL_SA_PASSWORD=
CZ_SCANNER_PASSWORD=
CZ_WEB_PASSWORD=
CZ_ADMIN_PASSWORD=

# Admin pages behind sign-in (optional; leave CONTAINERIZER_OIDC_ISSUER empty to turn them off).
# Register a web app at your identity provider with redirect URI <public URL>/auth/callback.
# Entra ID issuer: https://login.microsoftonline.com/<tenant id>/v2.0
CONTAINERIZER_OIDC_ISSUER=
CONTAINERIZER_OIDC_CLIENT_ID=
CONTAINERIZER_OIDC_CLIENT_SECRET=
# who may use the admin pages: group:<id>, role:<app role>, email:<address>, domain:<domain>, sub:<id>
CONTAINERIZER_ADMINS=
CONTAINERIZER_PUBLIC_URL=http://127.0.0.1:8080
