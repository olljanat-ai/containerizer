    {
      "type": "table",
      "title": "By application",
      "id": 12,
      "datasource": {
        "type": "mssql",
        "uid": "containerizer-sql"
      },
      "description": "",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "containerizer-sql"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT BusinessUnitName AS [Business unit], ProductName AS Product, ApplicationName AS Application, SUM(Calls) AS Calls, SUM(InputTokens) AS [Input Tokens], SUM(OutputTokens) AS [Output Tokens], SUM(Tokens) AS [Total Tokens], SUM(CostUsd) AS [Cost (USD)] FROM containerizer.vLlmUsageDaily WHERE $__timeFilter(Day) AND BusinessUnitName IN ($bu) AND ProductName IN ($product) AND ApplicationName IN ($app) GROUP BY BusinessUnitName, ProductName, ApplicationName ORDER BY [Total Tokens] DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cost (USD)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": ""
