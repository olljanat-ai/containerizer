          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ApplicationName AS Application, COALESCE(Component, N'(application)') AS Component, Feature, COUNT(*) AS Calls, SUM(CAST(InputTokens AS bigint)) AS [Input Tokens], SUM(CAST(OutputTokens AS bigint)) AS [Output Tokens], SUM(CAST(Tokens AS bigint)) AS [Total Tokens], SUM(CostUsd) AS [Cost (USD)] FROM containerizer.vLlmUsage WHERE $__timeFilter(At) AND BusinessUnitName IN ($bu) AND ProductName IN ($product) AND ApplicationName IN ($app) GROUP BY ApplicationName, Component, Feature ORDER BY [Total Tokens] DESC"
        }
