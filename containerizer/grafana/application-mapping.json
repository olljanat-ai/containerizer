{
  "uid": "containerizer-application-mapping",
  "title": "Containerizer: application mapping",
  "tags": [
    "containerizer",
    "mapping"
  ],
  "description": "How the applications are mapped to products, at the end of every organization scan run (discovery or full scan): the application IDs repositories declare in metadata.json, and the products they map to (the results database: cz.vMappingHistory).",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "graphTooltip": 1,
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Repositories with metadata.json",
      "id": 1,
      "datasource": {
        "type": "mssql",
        "uid": "containerizer-sql"
      },
      "description": "Repositories (not removed) whose metadata.json names an applicationId, as the latest run read it (discovery reads it through the provider's API, a full scan from the clone).",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "containerizer-sql"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT TOP (1) ReposDeclaring AS value FROM containerizer.vMappingHistory ORDER BY At DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Of all repositories",
      "id": 2,
      "datasource": {
        "type": "mssql",
        "uid": "containerizer-sql"
      },
      "description": "The share of the repositories that declare an application ID in metadata.json.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "containerizer-sql"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT TOP (1) CAST(100.0 * ReposDeclaring / NULLIF(Repositories, 0) AS decimal(5, 1)) AS value FROM containerizer.vMappingHistory ORDER BY At DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
