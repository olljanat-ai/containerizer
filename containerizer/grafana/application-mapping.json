    {
      "type": "timeseries",
      "title": "Applications by how they are mapped to a product",
      "id": 7,
      "datasource": {
        "type": "mssql",
        "uid": "containerizer-sql"
      },
      "description": "At the end of every run (discovery or full scan). By external ID: the product whose External ID is the application's ID. By project: one product per project, made by the scan. By hand: a product a person chose.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "containerizer-sql"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT At AS time, AppsByExternalId AS [By external ID], AppsByProject AS [By project], AppsByHand AS [By hand], AppsNoProduct AS [No product] FROM containerizer.vMappingHistory WHERE $__timeFilter(At) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "firstNotNull",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Repositories and application IDs",
      "id": 8,
      "datasource": {
        "type": "mssql",
        "uid": "containerizer-sql"
      },
      "description": "Repositories the organization scans list, those whose metadata.json declares an application ID, those of them with no application yet, and the applications that have an ID (their own or their repository's).",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "containerizer-sql"
          },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT At AS time, Repositories AS [Repositories], ReposDeclaring AS [Declare an ID], ReposDeclaringNoApp AS [Declare an ID, no application], AppsWithId AS [Applications with an ID], IdsWithoutProduct AS [IDs no product has] FROM containerizer.vMappingHistory WHERE $__timeFilter(At) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "lineWidth": 2,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "firstNotNull",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "table",
      "title": "Per day (the last run of the day)",
      "id": 9,
      "datasource": {
        "type": "mssql",
        "uid": "containerizer-sql"
      },
      "description": "The state at the end of each day's last run.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "containerizer-sql"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT Day, Repositories, ReposDeclaring AS [Declare an ID], ReposDeclaringNoApp AS [ID, no application], Applications, AppsWithId AS [With an ID], AppsByExternalId AS [By external ID], AppsByProject AS [By project], AppsByHand AS [By hand], AppsNoProduct AS [No product], IdsWithoutProduct AS [IDs no product has] FROM containerizer.vMappingHistory WHERE $__timeFilter(At) AND At IN (SELECT MAX(At) FROM containerizer.vMappingHistory GROUP BY Day) ORDER BY Day DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
