# /etc/containerizer/worker.env (chmod 600, owned by root): read by the systemd unit.
CONTAINERIZER_SQL=Server=tcp:sql.example.com,1433;Database=Containerizer;User Id=cz_scanner;Encrypt=yes
CONTAINERIZER_SQL_PASSWORD=
# the private key that opens the source control tokens registered under Admin -> Source control
# (containerizer credentials keygen; the web UI gets the public key). Tokens are not set here.
CONTAINERIZER_CREDENTIAL_KEY_FILE=/etc/containerizer/worker-credential.key
# push-only registry credentials
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
# registry hosts besides github.com, gitlab.com, dev.azure.com and *.visualstudio.com the worker may push to
CONTAINERIZER_WORKER_HOSTS=acmeregistry.azurecr.io
# optional: Prometheus must send "Authorization: Bearer <token>"
CONTAINERIZER_METRICS_TOKEN=
