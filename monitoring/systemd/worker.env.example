# /etc/containerizer/worker.env (chmod 600, owned by root): read by the systemd unit.
CONTAINERIZER_SQL=Server=tcp:sql.example.com,1433;Database=Containerizer;User Id=cz_scanner;Encrypt=yes
CONTAINERIZER_SQL_PASSWORD=
# read-only organization tokens, named in each scan's "Token variable" (CZ_TOKEN_<NAME>)
CZ_TOKEN_CONTOSO=
GITHUB_TOKEN=
# push access to the output repository only ("Output token variable", default OUTPUT_GIT_TOKEN)
OUTPUT_GIT_TOKEN=
# push-only registry credentials
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
# hosts besides github.com, gitlab.com, dev.azure.com and *.visualstudio.com that may receive tokens:
# self-hosted servers and the image registry
CONTAINERIZER_WORKER_HOSTS=acmeregistry.azurecr.io
# optional: Prometheus must send "Authorization: Bearer <token>"
CONTAINERIZER_METRICS_TOKEN=
