            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}[$__rate_interval])) > 0",
          "legendFormat": "{{namespace}}/{{pod}}",
