        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(gotk_resource_info{exported_namespace=~\"$namespace\",customresource_kind=~\"$kind\",suspended=\"true\"}) or vector(0)",
          "legendFormat": "",
